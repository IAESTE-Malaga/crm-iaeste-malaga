# Copia a .env (no se sube al repo) y rellena. En producción, pon estas variables en el panel del hosting.

# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# ¡SECRETA! Salta todas las políticas RLS. Solo en el servidor, nunca en el frontend ni en el repo.
SUPABASE_SERVICE_ROLE_KEY=

# --- Buzón compartido de Gmail ---
GMAIL_USER=crm.iaestemadrid@gmail.com
# Contraseña de aplicación de 16 letras (https://myaccount.google.com/apppasswords). NO la contraseña normal.
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=IAESTE Madrid

# --- API ---
PORT=8787
# URL(s) del frontend, separadas por comas
CORS_ORIGINS=http://localhost:5173
SENDS_PER_HOUR_PER_USER=30

# --- Sincronización IMAP ---
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=3
# Opcional: permite lanzar POST /api/sync desde un cron externo con "Authorization: Bearer <secreto>"
SYNC_SECRET=

# --- Opcionales (valores por defecto = Gmail) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465          # 465 + SMTP_SECURE=true (SSL)  |  587 + SMTP_SECURE=false (STARTTLS)
# SMTP_SECURE=true
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
